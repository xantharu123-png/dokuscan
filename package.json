{
  "name": "dokuscan",
  "private": true,
  "version": "1.0.0",
  "description": "Dokumente mit der iPhone-Kamera scannen und als PDF speichern",
  "type": "module",
  "scripts": {
    "build:www": "node tools/build-www.mjs",
    "ios:sync": "npm run build:www && npx cap sync ios",
    "serve": "node tools/serve.mjs",
    "icons": "node tools/make-icons.mjs",
    "test:detection": "node test/e2e/detection.mjs",
    "test:app": "node test/e2e/app.mjs",
    "test:signature": "node test/e2e/signature.mjs",
    "test": "node test/e2e/detection.mjs && node test/e2e/app.mjs && node test/e2e/signature.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
